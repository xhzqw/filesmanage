[Unit]
Description=filesmanage v2.1 isolated CAD conversion worker (development)
Documentation=file:///srv/filesmanage/docs/M8-BACKUP-AND-SERVICE-READINESS.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/filesmanage
EnvironmentFile=/srv/filesmanage/.secrets/server.env
ExecStart=/srv/filesmanage/.bin/worker
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/srv/filesmanage/.blobs
UMask=0077

[Install]
WantedBy=multi-user.target
